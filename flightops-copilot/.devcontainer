{
    "name": "FlightOps Copilot",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "postCreateCommand": "pip install -r requirements.txt",
    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python", "qwtel.sqlite-viewer"]
        }
    },
    "forwardPorts": [8501, 8000]
}